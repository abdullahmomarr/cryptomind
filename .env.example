# Copy to ".env" (or export in your shell) only if you want an LLM reasoning engine.
# The rule-based engine and all memory/data code run WITHOUT any key.

# Free LLM backend — OpenRouter (get a free key at https://openrouter.ai/settings/keys).
# Gives access to a rotating set of free models (Nemotron, Llama, etc.) behind one
# OpenAI-compatible endpoint. Put your key on the next line in your local .env
# (this file is the template; .env itself is gitignored and never committed).
OPENROUTER_API_KEY=your-openrouter-key-here

# Optional paid alternative — Anthropic Claude.
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: exchange for live/historical data. Default is "binance" (works locally).
# Binance is geo-blocked on most cloud hosts, so set this to "kraken" when deploying.
# CRYPTOMIND_EXCHANGE=kraken
